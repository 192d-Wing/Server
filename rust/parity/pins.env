# SPDX-License-Identifier: Apache-2.0
#
# Parity harness pins (CM-2, SR-4, SR-11). Single source of truth for
# rust/parity/harness.sh and .github/workflows/rust-parity.yml.
#
# Format: KEY=VALUE, one per line; '#' starts a comment line. This file is
# PARSED, never sourced: no quotes, no spaces, no shell expansion. Unknown
# keys and values that fail validation make the harness exit 4 (fail closed).
#
# Resolved 2026-10-26 (UTC) by release-engineer. Sources:
#   images:  Docker Hub registry v2 API, HEAD /v2/<repo>/manifests/<tag>,
#            header Docker-Content-Digest (multi-arch index digest where the
#            tag is an index).
#   gradle:  https://services.gradle.org/versions/all (checksumUrl and
#            wrapperChecksumUrl fields).
# To update: re-resolve, edit here, and record the change in
# rust/docs/compliance/ATO_EVIDENCE.md (CM-2 pin inventory).

# Build image for the Java reference (JDK 17, Ubuntu 22.04). Multi-arch OCI index.
JDK_BUILD_IMAGE=docker.io/library/eclipse-temurin:17-jdk-jammy@sha256:1dcfdf8a7f4f9d139931e2c98a0f95211462ddb11809f775590ac0003600c53a

# Runtime image for TAKCL + the Java server it spawns (JRE 17, no javac).
# Note: the tag "17-jammy" used by upstream testrunner.sh is the JDK, not the JRE.
JRE_RUN_IMAGE=docker.io/library/eclipse-temurin:17-jre-jammy@sha256:131f924767c0cde364fd7d3739dd3be79afd4e92d434bedc76b60ebd2ccb48f0

# PostgreSQL 15 + PostGIS 3.3 (same tag as upstream testrunner.sh). Single-arch
# (linux/amd64) image manifest; the tag was last pushed 2023-08-14.
# POAM: POAM-2026-10-26-03 - community image, pinned by digest only (not
# Iron Bank / UBI); test fixture, never shipped.
POSTGIS_IMAGE=docker.io/postgis/postgis:15-3.3@sha256:a2fc46b52819d25add4ed93d3da83e106e17ea3ace6883cce3791631c9820bb2

# Must match src/gradle/wrapper/gradle-wrapper.properties distributionUrl.
GRADLE_VERSION=8.10.2

# https://services.gradle.org/distributions/gradle-8.10.2-bin.zip.sha256
GRADLE_DIST_SHA256=31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26

# SHA-256 of src/gradle/wrapper/gradle-wrapper.jar. This jar is the genuine
# wrapper that Gradle published with 7.5 / 7.5.1
# (https://services.gradle.org/distributions/gradle-7.5.1-wrapper.jar.sha256);
# it is not the 8.10.2 wrapper (2db75c40...8046). Any wrapper jar can launch
# any distribution; the distribution itself is pinned by GRADLE_DIST_SHA256.
GRADLE_WRAPPER_JAR_SHA256=91a239400bb638f36a1795d8fdf7939d532cdc7d794d1119b7261aac158b1e60
